# Copia este archivo como .env y completa los valores.

# --- Servidor ---
NODE_ENV=development
PORT=3000
# Cadena larga y aleatoria para firmar la cookie de sesión (mínimo 32 caracteres)
SESSION_SECRET=cambia-esta-cadena-por-una-larga-y-aleatoria

# --- Base de datos MySQL 8.4 ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peruflower

# --- Administrador de prueba (lo crea npm run db:init) ---
ADMIN_NOMBRE=Administrador Perú Flowers
ADMIN_EMAIL=admin@peruflower.com
ADMIN_PASSWORD="Admin#2026"

# --- Negocio ---
# Número de la recepcionista para WhatsApp (código de país + número, sin + ni espacios)
WHATSAPP_NUMERO=51983573163
# Número de Yape/Plin del negocio (valor de ejemplo)
YAPE_PLIN_NUMERO=999888777
YAPE_PLIN_TITULAR=Perú Flowers
# Imagen del QR de Yape/Plin del negocio (opcional). Guárdala en public/img/pagos/ y escribe su ruta:
YAPE_PLIN_QR=

