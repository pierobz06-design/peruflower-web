<%# Inicio de las páginas del panel de administración. Parámetro: titulo %>
<% const hojas = ['base/variables', 'base/reset', 'base/tipografia', 'base/utilidades', 'base/animaciones',
  'components/botones', 'components/formularios', 'components/avisos', 'pages/admin']; %>
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><%= titulo %></title>
    <% if (typeof csrfToken !== 'undefined') { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <link rel="icon" href="/img/iconos/favicon.png" type="image/png">
    <% for (const hoja of hojas) { %>
    <link rel="stylesheet" href="/css/<%= hoja %>.css">
    <% } %>
    <script type="module" src="/js/admin/admin.js"></script>
  </head>
  <body class="admin">
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>
