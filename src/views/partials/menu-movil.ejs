<div class="menu-movil" id="menu-movil" data-menu-movil hidden>
  <div class="menu-movil__fondo" data-cerrar-menu></div>
  <div class="menu-movil__panel" role="dialog" aria-modal="true" aria-labelledby="menu-movil-titulo">
    <div class="menu-movil__cabecera">
      <p class="menu-movil__titulo" id="menu-movil-titulo">Menú</p>
      <button class="boton-cerrar" type="button" aria-label="Cerrar menú" data-cerrar-menu>
        <%- include('icono', { nombre: 'cerrar' }) %>
      </button>
    </div>
    <nav aria-label="Menú del celular">
      <ul class="menu-movil__lista">
        <li><a class="menu-movil__enlace" href="/">Inicio</a></li>
        <li><a class="menu-movil__enlace" href="/catalogo">Catálogo</a></li>
        <li class="menu-movil__grupo">
          <button class="menu-movil__enlace menu-movil__acordeon" type="button" aria-expanded="false" aria-controls="menu-movil-ocasiones" data-acordeon>
            Ocasiones <%- include('icono', { nombre: 'chevron-abajo' }) %>
          </button>
          <ul class="menu-movil__sublista" id="menu-movil-ocasiones" hidden>
            <% for (const categoria of categoriasMenu) { %>
            <li><a class="menu-movil__subenlace" href="<%= crearEnlaceCatalogo({ ocasion: categoria.slug }) %>"><%= categoria.nombre %></a></li>
            <% } %>
          </ul>
        </li>
        <li><a class="menu-movil__enlace" href="/#como-comprar">Cómo comprar</a></li>
        <li><a class="menu-movil__enlace" href="/#nosotros">Nosotros</a></li>
        <% if (clienteActual) { %>
        <li><a class="menu-movil__enlace" href="/carrito">Mi carrito</a></li>
        <li>
          <form action="/salir" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="menu-movil__enlace" type="submit">Cerrar sesión (<%= clienteActual.nombre %>)</button>
          </form>
        </li>
        <% } else { %>
        <li><a class="menu-movil__enlace" href="/ingresar">Iniciar sesión</a></li>
        <li><a class="menu-movil__enlace" href="/registro">Crear cuenta</a></li>
        <% } %>
      </ul>
    </nav>
    <a class="boton boton--whatsapp menu-movil__whatsapp" href="<%= enlaceWhatsapp %>" target="_blank" rel="noopener">
      <%- include('icono', { nombre: 'whatsapp' }) %> Pedir asesoría
    </a>
  </div>
</div>
