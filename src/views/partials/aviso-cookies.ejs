<%# Aviso informativo de cookies: la tienda solo usa una cookie necesaria (sesión y carrito). %>
<div class="aviso-cookies" role="region" aria-label="Aviso de cookies" hidden data-aviso-cookies>
  <p class="aviso-cookies__texto">
    Usamos una cookie necesaria para mantener tu sesión y tu carrito. No usamos cookies de publicidad.
    <a href="/politica-de-privacidad">Política de privacidad</a>
  </p>
  <button class="aviso-cookies__boton" type="button" data-aceptar-cookies>Entendido</button>
</div>
